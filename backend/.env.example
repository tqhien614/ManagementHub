# PostgreSQL connection — replace YOUR_PASSWORD with the postgres user's password
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/managementhub

# JWT
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI (embeddings only — leave empty to use keyword search fallback)
OPENAI_API_KEY=

# Anthropic (LLM for RAG answers + Copilot) — proxy-compatible endpoint
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-5

# SMTP (OTP email, M1+; leave empty to print OTP to console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@managementhub.local

# Uploads
UPLOAD_DIR=storage/uploads

# CORS
FRONTEND_URL=http://localhost:3000

# Dev: print OTP to console instead of sending email
DEV_PRINT_OTP=true
